# Apiserver control plane — the UI's ONLY view of control-plane state: topology
# and meta reads, the desired-state forms, and operator chaos (cordon, drain,
# delete replica). The UI holds no database credentials.
CONTROL_PLANE_URL=http://localhost:7080

# Simulated agent fleet — agent-observable chaos (kill host, crash, stall).
AGENTSIM_URL=http://localhost:7780

# Engine slog text log the /logs view tails. Written by the engine when
# CONDUCTOR_LOG_FILE points at the same path on a shared volume.
LOG_FILE=/var/log/conductor/engine.log
