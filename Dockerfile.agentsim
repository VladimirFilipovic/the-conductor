# syntax=docker/dockerfile:1
# Builds the conductor binary and runs it as the simulated host-agent fleet:
# one agent per host, chaos control API on :7780. No DB access — agents talk
# only to the apiserver's gRPC gateway, exactly like real agents would.

FROM golang:1.25-alpine AS builder
WORKDIR /src

RUN apk add --no-cache git
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/conductor .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/conductor /usr/local/bin/conductor

# Addresses come from CONDUCTOR_AGENTAPI_ADDR / CONDUCTOR_CONTROL_ADDR rather
# than baked-in flags, so the same image runs anywhere the apiserver happens to
# live without overriding the command.
ENTRYPOINT ["conductor", "agentsim"]
